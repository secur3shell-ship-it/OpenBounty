# Copy to .env.local and adjust. Everything starting with NEXT_PUBLIC_ is
# visible in the browser, so never put secrets here.

# Devnet RPC. The public URL below works but is slow. For local development,
# put the full devnet URL of the *local* Helius key here, e.g.
# https://devnet.helius-rpc.com/?api-key=<local key>
# The live site's key is set in Vercel; the deployer's RPC never goes here.
# See "RPC endpoints" in the root README.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# PARKED: origin of the real-time market feed backend (docs/features/markets-feed.md).
# Leave unset: prices then come from CoinGecko and news from Solana's RSS, in the browser.
# NEXT_PUBLIC_MARKET_FEED_URL=http://localhost:4000
