# Copy to .env.local and adjust. Everything starting with NEXT_PUBLIC_ is
# visible in the browser, so never put secrets here.

# Devnet RPC. The public URL works but is often slow; ask the project owner
# for your own provider key (e.g. Helius) and put that URL in .env.local.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
